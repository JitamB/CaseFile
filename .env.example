# Provider for the three LLM calls (§17) — one of: anthropic, google, groq.
# Empty defaults to anthropic. google/groq need `pip install -e ".[providers]"`
# (their SDKs are not installed by default — pyproject.toml's `providers` extra).
# Decision D-2 — see docs/09-build-protocol.md §47.2.
LLM_PROVIDER=

# Which model class within that provider — optional, each provider falls back
# to its own default when this is empty. Valid values:
#   anthropic: opus | sonnet | haiku            (or set CASEFILE_MODEL instead)
#   google:    gemini-pro | gemini-flash | gemini-lite
#   groq:      groq-120b | groq-20b
LLM_MODEL=

# Only the credential for whichever LLM_PROVIDER you selected is actually
# read; the other two can stay empty.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Anthropic's own model-tier override, from before LLM_MODEL existed — still
# works standalone. Telemetry reads a price table, so this stays
# configuration rather than code.
CASEFILE_MODEL=

# When true, the LLM layer replays recorded responses from llm_cache/ and never
# reaches the network. CI always runs with this on; leave it on locally unless
# you are deliberately recording new responses.
CASEFILE_LLM_REPLAY=true
